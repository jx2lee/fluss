+package org.apache.fluss.server.kv.rowmerger.aggregate.factory;
+
+import org.apache.fluss.metadata.AggFunction;
+import org.apache.fluss.metadata.AggFunctionType;
+import org.apache.fluss.metadata.AggFunctions;
+import org.apache.fluss.types.DataType;
+import org.apache.fluss.types.DataTypeRoot;
+import org.apache.fluss.types.DataTypes;
+
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+import java.util.Collections;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatNoException;
+
+/** Tests for {@link FieldAggregatorFactory}. */
+class FieldAggregatorFactoryTest {
+
+    /**
+     * Table creation validates aggregation columns against {@link
+     * AggFunctionType#getSupportedDataTypeRoots()}. Every type accepted there must also be accepted
+     * when the aggregator is created on the first write, otherwise the table accepts the DDL but
+     * rejects every write.
+     */
+    @ParameterizedTest
+    @EnumSource(AggFunctionType.class)
+    void testCreateAggregatorForEverySupportedDataType(AggFunctionType type) {
+        AggFunction aggFunction =
+                AggFunctions.of(
+                        type,
+                        type == AggFunctionType.LAST_N
+                                ? Collections.singletonMap(AggFunctions.PARAM_SIZE, "3")
+                                : Collections.emptyMap());
+        FieldAggregatorFactory factory = FieldAggregatorFactory.getFactory(type);
+        assertThat(factory).isNotNull();
+        for (DataTypeRoot root : type.getSupportedDataTypeRoots()) {
+            DataType dataType = sampleType(root);
+            aggFunction.validateDataType(dataType);
+            assertThatNoException()
+                    .as("creating %s aggregator for %s", type, dataType)
+                    .isThrownBy(() -> factory.create(dataType, aggFunction));
+        }
+    }
+
+    private static DataType sampleType(DataTypeRoot root) {
+        switch (root) {
+            case CHAR:
+                return DataTypes.CHAR(10);
+            case STRING:
+                return DataTypes.STRING();
+            case BOOLEAN:
+                return DataTypes.BOOLEAN();
+            case BINARY:
+                return DataTypes.BINARY(10);
+            case BYTES:
+                return DataTypes.BYTES();
+            case DECIMAL:
+                return DataTypes.DECIMAL(10, 2);
+            case TINYINT:
+                return DataTypes.TINYINT();
+            case SMALLINT:
+                return DataTypes.SMALLINT();
+            case INTEGER:
+                return DataTypes.INT();
+            case BIGINT:
+                return DataTypes.BIGINT();
+            case FLOAT:
+                return DataTypes.FLOAT();
+            case DOUBLE:
+                return DataTypes.DOUBLE();
+            case DATE:
+                return DataTypes.DATE();
+            case TIME_WITHOUT_TIME_ZONE:
+                return DataTypes.TIME();
+            case TIMESTAMP_WITHOUT_TIME_ZONE:
+                return DataTypes.TIMESTAMP(3);
+            case TIMESTAMP_WITH_LOCAL_TIME_ZONE:
+                return DataTypes.TIMESTAMP_LTZ(3);
+            case ARRAY:
+                return DataTypes.ARRAY(DataTypes.INT());
+            case MAP:
+                return DataTypes.MAP(DataTypes.STRING(), DataTypes.INT());
+            case ROW:
+                return DataTypes.ROW(DataTypes.FIELD("f0", DataTypes.INT()));
+            default:
+                throw new IllegalArgumentException("Unsupported data type root: " + root);
+        }
+    }
+}
