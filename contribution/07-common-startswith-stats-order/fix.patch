+    @Test
+    public void testStartWithStatisticsUseBinaryStringOrder() {
+        // Batch statistics min/max are collected with BinaryString#compareTo (UTF-8 byte order,
+        // i.e. code point order). UTF-16 order (String#compareTo) disagrees with it for BMP chars
+        // in U+E000..U+FFFF vs. supplementary chars (e.g. fullwidth forms vs. emoji).
+        BinaryString a = fromString("a");
+        BinaryString fullwidth = fromString("ＡＢ"); // "ＡＢ"
+        BinaryString emoji = fromString("😀"); // U+1F600
+        assertThat(a.compareTo(fullwidth)).isLessThan(0);
+        assertThat(fullwidth.compareTo(emoji)).isLessThan(0);
+
+        // A batch containing {"a", "ＡＢ", "😀"} has min = "a" and max = "😀".
+        PredicateBuilder builder = new PredicateBuilder(RowType.of(new StringType()));
+        Predicate predicate = builder.startsWith(0, fromString("Ａ"));
+        assertThat(predicate.test(GenericRow.of(fullwidth))).isTrue();
+        assertThat(predicate.test(3, row(a), row(emoji), new int[] {0})).isTrue();
+
+        // A batch containing {"Ａ", "😀🎉"} with pattern "😀".
+        Predicate emojiPrefix = builder.startsWith(0, emoji);
+        BinaryString emojiParty = fromString("😀🎉");
+        assertThat(emojiPrefix.test(GenericRow.of(emojiParty))).isTrue();
+        assertThat(emojiPrefix.test(2, row(fromString("Ａ")), row(emojiParty), new int[] {0}))
+                .isTrue();
+    }
+
