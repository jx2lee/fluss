+    @Test
+    void testAlterTableAddNonPhysicalColumn() throws Exception {
+        String tableName = "test_alter_add_non_physical_column";
+        ObjectPath tablePath = new ObjectPath(DEFAULT_DB, tableName);
+        tEnv.executeSql(
+                String.format(
+                        "CREATE TABLE %s (id BIGINT, a INT, PRIMARY KEY (id) NOT ENFORCED)",
+                        tableName));
+
+        String[] alterStatements = {
+            String.format("ALTER TABLE %s ADD c AS a + 1", tableName),
+            String.format(
+                    "ALTER TABLE %s ADD m TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'", tableName)
+        };
+        for (String alter : alterStatements) {
+            Throwable error = catchThrowable(() -> tEnv.executeSql(alter));
+
+            // The non-physical column must not end up as a physical Fluss column.
+            CatalogTable table = (CatalogTable) catalog.getTable(tablePath);
+            assertThat(table.getUnresolvedSchema().getColumns())
+                    .as("columns after: %s", alter)
+                    .extracting(Schema.UnresolvedColumn::getName)
+                    .containsExactly("id", "a");
+            assertThat(error)
+                    .as("error of: %s", alter)
+                    .hasStackTraceContaining("Adding non-physical column");
+        }
+    }
