+    @Test
+    void testWildcardWithSurroundingWhitespaceIsTreatedAsAllColumns() {
+        // Only id(INT) and name(STRING) are supported statistics types in TEST_SCHEMA.
+        for (String wildcard : new String[] {" *", "* ", " * "}) {
+            TableDescriptor descriptor =
+                    TableDescriptor.builder()
+                            .schema(TEST_SCHEMA)
+                            .distributedBy(3)
+                            .property(ConfigOptions.TABLE_STATISTICS_COLUMNS.key(), wildcard)
+                            .build();
+
+            assertThatNoException()
+                    .isThrownBy(() -> StatisticsConfigUtils.validateStatisticsConfig(descriptor));
+
+            // The value accepted by validation must also be usable at runtime.
+            TableInfo tableInfo =
+                    TableInfo.of(TablePath.of("db", "t"), 1L, 1, descriptor, "/tmp", 0L, 0L);
+            assertThat(tableInfo.getTableConfig().getStatisticsColumns().getMode())
+                    .isEqualTo(StatisticsColumnsConfig.Mode.ALL);
+            assertThat(tableInfo.getStatsIndexMapping()).containsExactly(0, 1);
+            // The client creates this collector for every batch it appends.
+            assertThatNoException()
+                    .isThrownBy(
+                            () ->
+                                    new LogRecordBatchStatisticsCollector(
+                                            tableInfo.getRowType(),
+                                            tableInfo.getStatsIndexMapping()));
+        }
+    }
+
+    @Test
+    void testDuplicateColumnsAreDeduplicated() {
+        TableDescriptor descriptor =
+                TableDescriptor.builder()
+                        .schema(TEST_SCHEMA)
+                        .distributedBy(3)
+                        .property(ConfigOptions.TABLE_STATISTICS_COLUMNS.key(), "id, name, id")
+                        .build();
+
+        assertThatNoException()
+                .isThrownBy(() -> StatisticsConfigUtils.validateStatisticsConfig(descriptor));
+
+        // A duplicated column must not produce a duplicated statistics field, which would make
+        // the statistics row type invalid and fail every append.
+        TableInfo tableInfo =
+                TableInfo.of(TablePath.of("db", "t"), 1L, 1, descriptor, "/tmp", 0L, 0L);
+        assertThat(tableInfo.getTableConfig().getStatisticsColumns().getColumns())
+                .containsExactly("id", "name");
+        assertThat(tableInfo.getStatsIndexMapping()).containsExactly(0, 1);
+        assertThatNoException()
+                .isThrownBy(
+                        () ->
+                                new LogRecordBatchStatisticsCollector(
+                                        tableInfo.getRowType(), tableInfo.getStatsIndexMapping()));
+    }
