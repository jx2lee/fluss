+    /**
+     * Returns the max timestamp of the latest non-empty segment, or -1 if all segments are empty.
+     *
+     * <p>The active segment can be empty while older segments still hold data, e.g. after the TTL
+     * cleanup rolled the active segment of an idle bucket, so empty segments are skipped. Only as
+     * many segments as needed are inspected, because this may materialize their time indexes.
+     */
+    private static long latestMaxTimestamp(LogSegments segments) throws IOException {
+        List<LogSegment> values = segments.values();
+        for (int i = values.size() - 1; i >= 0; i--) {
+            LogSegment segment = values.get(i);
+            if (segment.getSizeInBytes() > 0) {
+                return segment.maxTimestampSoFar();
+            }
+        }
+        return -1L;
     }
 
