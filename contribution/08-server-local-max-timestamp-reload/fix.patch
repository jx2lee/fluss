+    @Test
+    void testLocalMaxTimestampIsRestoredWhenActiveSegmentIsEmpty() throws Exception {
+        logTablet.appendAsLeader(genMemoryLogRecordsByObject(DATA1));
+        long maxTimestamp = logTablet.localMaxTimestamp();
+        assertThat(maxTimestamp).isGreaterThan(0L);
+
+        // Rolling leaves an empty active segment, e.g. when the TTL cleanup rolls an expired
+        // active segment of an idle bucket.
+        logTablet.roll(Optional.empty());
+        assertThat(logTablet.activeLogSegment().getSizeInBytes()).isZero();
+        assertThat(logTablet.localMaxTimestamp()).isEqualTo(maxTimestamp);
+        logTablet.flush(true);
+        logTablet.close();
+
+        // Reload the log, as a tablet server restart does.
+        LogTablet reloaded =
+                LogTablet.create(
+                        tempDir,
+                        PhysicalTablePath.of(DATA1_TABLE_PATH),
+                        logDir,
+                        conf,
+                        new AtomicBoolean(
+                                conf.get(ConfigOptions.LOG_RETENTION_ROLL_ACTIVE_SEGMENT_ENABLED)),
+                        TestingMetricGroups.TABLET_SERVER_METRICS,
+                        0,
+                        scheduler,
+                        LogFormat.ARROW,
+                        1,
+                        false,
+                        SystemClock.getInstance(),
+                        true);
+        try {
+            assertThat(reloaded.logSegments()).hasSize(2);
+            // The data is still there and can be found by timestamp ...
+            assertThat(reloaded.lookupOffsetForTimestamp(maxTimestamp)).isEqualTo(0L);
+            // ... so the local max timestamp must not regress to -1, otherwise list offsets by
+            // timestamp short-circuits to the latest offset (see Replica#getOffsetByTimestamp).
+            assertThat(reloaded.localMaxTimestamp()).isEqualTo(maxTimestamp);
+        } finally {
+            reloaded.close();
+        }
+    }
